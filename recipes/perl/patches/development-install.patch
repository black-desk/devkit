-$Config_PM = "lib/Config.pm";
-$Config_POD = "lib/Config.pod";
+# Generate a separate consumer configuration after building and testing Perl.
+# The build configuration must retain the bootstrap compiler and flags.
+my $devkit_dir = $ENV{DEVKIT_CONFIG_DIR};
+$Config_PM = $devkit_dir ? "$devkit_dir/Config.pm" : "lib/Config.pm";
+$Config_POD = $devkit_dir ? "$devkit_dir/Config.pod" : "lib/Config.pod";
 $Config_SH = "config.sh";
 
