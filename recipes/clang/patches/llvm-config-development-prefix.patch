From: devkit maintainers
Subject: Resolve installed LLVM development interfaces in the hidden prefix

TODO: propose configurable runtime/development directory separation upstream.
Keep build-tree llvm-config behavior unchanged and detect the staged install.
This compiled query-tool behavior remains separate from the recipe-local file
moves: llvm-config must resolve its include/lib/package directories together.
Rewriting archive locations alone cannot change its executable's lookup logic.

--- a/llvm/tools/llvm-config/llvm-config.cpp
+++ b/llvm/tools/llvm-config/llvm-config.cpp
@@ -372,6 +372,14 @@
       SmallString<256> Path(LLVM_INSTALL_PACKAGE_DIR);
       sys::path::make_absolute(ActivePrefix, Path);
       ActiveCMakeDir = std::string(Path);
+    }
+    // The channel keeps development interfaces separate from runtime libraries.
+    // Leave in-tree behavior and ordinary upstream installations unchanged.
+    std::string DevelopmentPrefix = ActivePrefix + "/lib/devkit";
+    if (sys::fs::exists(DevelopmentPrefix + "/lib/cmake/llvm/LLVMConfig.cmake")) {
+      ActiveIncludeDir = DevelopmentPrefix + "/include";
+      ActiveLibDir = DevelopmentPrefix + "/lib";
+      ActiveCMakeDir = DevelopmentPrefix + "/lib/cmake/llvm";
     }
     ActiveIncludeOptions.push_back(ActiveIncludeDir);
   }
