Install development interfaces and generate their paths in the upstream build.
Keep runtime libraries in the public lib directory.

--- a/cmake/autotools/expat__linux.cmake.in
+++ b/cmake/autotools/expat__linux.cmake.in
@@ -59,7 +59,7 @@
 add_library(expat::expat SHARED IMPORTED)
 
 set_target_properties(expat::expat PROPERTIES
-  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
+  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include/expat-@PACKAGE_VERSION@"
   INTERFACE_LINK_LIBRARIES "m"
 )
 
