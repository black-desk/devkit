@@ -35,2 +35 @@
-  # CMake install location
-  "${_CMAKE_INSTALL_DIR}"
+  # Devkit: the tool installation is not an implicit development prefix.
@@ -104 +103,7 @@
-    list(APPEND CMAKE_SYSTEM_PREFIX_PATH "$ENV{CONDA_PREFIX}")
+    file(REAL_PATH "$ENV{CONDA_PREFIX}" _devkit_conda_prefix)
+    file(REAL_PATH "${_CMAKE_INSTALL_DIR}" _devkit_cmake_prefix)
+    if(NOT _devkit_conda_prefix STREQUAL _devkit_cmake_prefix)
+      list(APPEND CMAKE_SYSTEM_PREFIX_PATH "$ENV{CONDA_PREFIX}")
+    endif()
+    unset(_devkit_conda_prefix)
