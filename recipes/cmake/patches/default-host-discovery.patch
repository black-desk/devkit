Default to host development libraries while keeping channel tools usable.
Explicit CMAKE_PREFIX_PATH, package roots/dirs, hints and project install
prefixes remain opt-in. Resolve symlinks before filtering implicit PATH entries.

--- a/Source/cmFindCommon.h
+++ b/Source/cmFindCommon.h
@@ -31,0 +32,3 @@
+
+  // Devkit: exclude implicit searches inside this tool installation.
+  static bool IsOwnInstallPath(std::string const& path);
--- a/Source/cmFindCommon.cxx
+++ b/Source/cmFindCommon.cxx
@@ -31,0 +32,12 @@
+
+bool cmFindCommon::IsOwnInstallPath(std::string const& path)
+{
+  auto const prefix = cmSystemTools::GetRealPath(
+    cmSystemTools::GetFilenamePath(
+      cmSystemTools::GetFilenamePath(cmSystemTools::GetCMakeRoot())));
+  auto const candidate = cmSystemTools::GetRealPath(path);
+  return candidate == prefix ||
+    (candidate.size() > prefix.size() &&
+     candidate.compare(0, prefix.size(), prefix) == 0 &&
+     candidate[prefix.size()] == '/');
+}
--- a/Source/cmSearchPath.cxx
+++ b/Source/cmSearchPath.cxx
@@ -88,0 +89,5 @@
+    // Keep program lookup and explicitly supplied environment paths intact.
+    if (variable == "PATH" && this->FC->CMakePathName != "PROGRAM" &&
+        cmFindCommon::IsOwnInstallPath(p)) {
+      continue;
+    }
--- a/Source/cmFindPackageCommand.cxx
+++ b/Source/cmFindPackageCommand.cxx
@@ -2125,0 +2126,3 @@
+    if (cmFindCommon::IsOwnInstallPath(i)) {
+      continue;
+    }
