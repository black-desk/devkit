--- a/pcre2-config.in
+++ b/pcre2-config.in
@@ -3,6 +3,21 @@
 prefix=@prefix@
 exec_prefix=@exec_prefix@
 exec_prefix_set=no
+includedir=@includedir@
+libdir=@libdir@
+static_cflag='@PCRE2_STATIC_CFLAG@'
+posix_cflag='@PCRE2POSIX_CFLAG@'
+
+# The conda package installs this helper under libexec/pcre2/bin rather than
+# bin. Resolve the installation prefix from that location so its output is
+# relocatable. The configured paths remain as a fallback for in-tree use.
+devkit_prefix=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd) || devkit_prefix=
+if test -n "$devkit_prefix" && test -f "$devkit_prefix/include/pcre2-@PACKAGE_VERSION@/pcre2.h"; then
+  prefix=$devkit_prefix
+  exec_prefix=$devkit_prefix
+  includedir=$prefix/include/pcre2-@PACKAGE_VERSION@
+  libdir=$exec_prefix/lib
+fi

 cflags="[--cflags]"
 libs=
@@ -27,28 +42,10 @@
   exit 1
 fi

-libR=
+libext=so
 case `uname -s` in
-  *SunOS*)
-  libR=" -R@libdir@"
-  ;;
-  *BSD*)
-  libR=" -Wl,-R@libdir@"
-  ;;
-esac
-
-libS=
-case "@libdir@" in
-  # system locations on Linux, no -L needed
-  /usr/lib|/usr/lib32|/usr/lib64|/usr/lib/*-gnu*)
-  ;;
-  /lib|/lib32|/lib64|/lib/*-gnu*)
-  ;;
-  # system locations on AIX and Solaris, no -L needed
-  /usr/lib/64|/usr/lib/amd*|/usr/lib/sparc*|/usr/lib/ppc*)
-  ;;
-  *)
-  libS="-L@libdir@"
+  Darwin*)
+  libext=dylib
   ;;
 esac

@@ -79,45 +76,45 @@
       echo @PACKAGE_VERSION@
       ;;
     --cflags)
-      if test @includedir@ != /usr/include ; then
-        includes=-I@includedir@
+      if test "$includedir" != /usr/include ; then
+        includes=-I"$includedir"
       fi
-      echo $includes @PCRE2_STATIC_CFLAG@
+      echo "$includes${static_cflag:+ $static_cflag}"
       ;;
     --cflags-posix)
       if test @enable_pcre2_8@ = yes ; then
-        if test @includedir@ != /usr/include ; then
-          includes=-I@includedir@
+        if test "$includedir" != /usr/include ; then
+          includes=-I"$includedir"
         fi
-        echo $includes @PCRE2POSIX_CFLAG@
+        echo "$includes${posix_cflag:+ $posix_cflag}"
       else
         echo "${usage}" 1>&2
       fi
       ;;
     --libs-posix)
       if test @enable_pcre2_8@ = yes ; then
-        echo $libS$libR -lpcre2-posix@LIB_POSTFIX@ -lpcre2-8@LIB_POSTFIX@
+        echo "$libdir/libpcre2-posix@LIB_POSTFIX@.$libext $libdir/libpcre2-8@LIB_POSTFIX@.$libext"
       else
         echo "${usage}" 1>&2
       fi
       ;;
     --libs8)
       if test @enable_pcre2_8@ = yes ; then
-        echo $libS$libR -lpcre2-8@LIB_POSTFIX@
+        echo "$libdir/libpcre2-8@LIB_POSTFIX@.$libext"
       else
         echo "${usage}" 1>&2
       fi
       ;;
     --libs16)
       if test @enable_pcre2_16@ = yes ; then
-        echo $libS$libR -lpcre2-16@LIB_POSTFIX@
+        echo "$libdir/libpcre2-16@LIB_POSTFIX@.$libext"
       else
         echo "${usage}" 1>&2
       fi
       ;;
     --libs32)
       if test @enable_pcre2_32@ = yes ; then
-        echo $libS$libR -lpcre2-32@LIB_POSTFIX@
+        echo "$libdir/libpcre2-32@LIB_POSTFIX@.$libext"
       else
         echo "${usage}" 1>&2
       fi
