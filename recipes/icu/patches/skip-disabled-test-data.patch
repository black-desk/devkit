Respect --disable-tests when generating test-data build rules.

FIXME: configure.ac and configure are currently edited manually in parallel.
The ICU 78.3 release configure was generated by GNU Autoconf 2.72. Regenerate
configure with Autoconf 2.72 (cd source && autoconf), then review and replace
the generated-script diff before submitting upstream or updating this patch.

The release source archive already supports prebuilt production data. Avoid
invoking Python solely for disabled tests; leave an empty rules.mk for the
configured test-data Makefile. Keep configure.ac and the shipped configure
script synchronized, so applying this patch does not require Autoconf.

--- a/source/configure.ac
+++ b/source/configure.ac
@@ -1269,15 +1269,19 @@
       echo "Not rebuilding data/rules.mk, assuming prebuilt data in data/in"
       touch data/rules.mk
     fi
-    echo "Spawning Python to generate test/testdata/rules.mk..."
-    PYTHONPATH="$srcdir/python" \
-        $PYTHON -m icutools.databuilder \
-        --mode gnumake \
-        --seqmode parallel \
-        --src_dir "$srcdir/test/testdata" \
-        > test/testdata/rules.mk
-    if test "$?" != "0"; then
-        AC_MSG_ERROR(Python failed to run; see above error.)
+    if test "$tests" = true; then
+        echo "Spawning Python to generate test/testdata/rules.mk..."
+        PYTHONPATH="$srcdir/python" \
+            $PYTHON -m icutools.databuilder \
+            --mode gnumake \
+            --seqmode parallel \
+            --src_dir "$srcdir/test/testdata" \
+            > test/testdata/rules.mk
+        if test "$?" != "0"; then
+            AC_MSG_ERROR(Python failed to run; see above error.)
+        fi
+    else
+        echo "" > test/testdata/rules.mk
     fi
 fi

