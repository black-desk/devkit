Install development interfaces and generate their paths in the upstream build.
Keep runtime libraries in the public lib directory.

The .pc prefix below denotes the hidden development prefix, not the
public runtime prefix. Deriving it from pcfiledir keeps it relocatable;
its linker interfaces resolve to runtime libraries in public lib.

TODO: replace channel-specific directory/version literals with configurable
install settings and generate metadata from those same settings. A future
channel .pc file could suggest pkgconfigdir to projects; CMake projects
should expose a separate package-config installation directory. Recipes
would select the channel metadata through PKG_CONFIG_LIBDIR explicitly.
For now, direct source-template/install-rule patches produce the intended
layout without that coordinated upstream/channel change. See
docs/recipe-review.md for the review decisions and deferred work.

--- a/build/cmake/CMakeLists.txt
+++ b/build/cmake/CMakeLists.txt
@@ -210,7 +210,7 @@
     )
 
 # A Package Config file that works from the installation directory
-set(ConfigPackageLocation ${CMAKE_INSTALL_LIBDIR}/cmake/zstd)
+set(ConfigPackageLocation lib/devkit/lib/cmake/zstd)
 install(EXPORT zstdExports
     FILE zstdTargets.cmake
     NAMESPACE zstd::
--- a/build/cmake/lib/CMakeLists.txt
+++ b/build/cmake/lib/CMakeLists.txt
@@ -267,7 +267,7 @@
 set(VERSION "${zstd_VERSION}")
 
 configure_file("${LIBRARY_DIR}/libzstd.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/libzstd.pc" @ONLY)
-install(FILES "${CMAKE_CURRENT_BINARY_DIR}/libzstd.pc" DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig")
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/libzstd.pc" DESTINATION "lib/devkit/lib/pkgconfig")
 
 # install target
 install(FILES ${PublicHeaders} DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
@@ -275,7 +275,7 @@
 install(TARGETS ${library_targets}
     EXPORT zstdExports
     INCLUDES DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}"
-    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+    ARCHIVE DESTINATION "lib/devkit/lib"
     LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
     RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
     BUNDLE DESTINATION "${CMAKE_INSTALL_BINDIR}"
--- a/lib/libzstd.pc.in
+++ b/lib/libzstd.pc.in
@@ -2,15 +2,15 @@
