Use CMake's build-tree RUNPATH so tests load the just-built shared library.
Installed ELF RUNPATH is supplied by the recipe through CMAKE_INSTALL_RPATH.

--- a/build/cmake/CMakeLists.txt
+++ b/build/cmake/CMakeLists.txt
@@ -24,1 +24,1 @@
-set(CMAKE_BUILD_WITH_INSTALL_RPATH on)
+set(CMAKE_BUILD_WITH_INSTALL_RPATH off)
