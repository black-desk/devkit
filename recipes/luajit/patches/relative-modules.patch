--- a/src/lib_package.c
+++ b/src/lib_package.c
@@ -35,6 +35,25 @@
 #if LJ_TARGET_DLOPEN

 #include <dlfcn.h>
+#if LJ_TARGET_LINUX
+#include <limits.h>
+#undef setprogdir
+/* Anchor defaults to the shared library, including when embedded in an editor. */
+static void setprogdir(lua_State *L)
+{
+  Dl_info info;
+  char path[PATH_MAX];
+  char *slash;
+  if (!dladdr((void *)luaopen_package, &info) ||
+      !realpath(info.dli_fname, path) || !(slash = strrchr(path, '/'))) {
+    luaL_error(L, "cannot locate LuaJIT shared library");
+    return;
+  }
+  *slash = '\0';
+  luaL_gsub(L, lua_tostring(L, -1), LUA_EXECDIR, path);
+  lua_remove(L, -2);
+}
+#endif

 static void ll_unloadlib(void *lib)
