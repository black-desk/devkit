# Preserve explicit Clang driver policy in shared-library links.
# Libtool otherwise drops --config/--no-default-config/--ld-path and reloads
# Clang's host defaults. An affected build linked against host glibc 2.32/2.34
# despite compiling against the channel's 2.28 sysroot; successful tests on a
# newer host did not detect that ABI leak. Retain the explicit policy at link.
# TODO: submit this flag support to GNU libtool upstream.
--- a/build-aux/ltmain.sh
+++ b/build-aux/ltmain.sh
@@ -7815,6 +7815,11 @@
       # -f{file|debug|macro|profile}-prefix-map=* needed for lto linking
       # -Wa,*                Pass flags directly to the assembler
       # -W*                  Warnings, needed for lto
+      # TODO: upstream Clang config/runtime/linker flag support to libtool.
+      # Preserve the compilation policy when composing shared-library links.
+      --config=*|--no-default-config|--ld-path=*|--gcc-install-dir=*|\
+      --gcc-toolchain=*|--rtlib=*|--unwindlib=*|\
+      --start-no-unused-arguments|--end-no-unused-arguments|\
       -64|-mips[0-9]|-r[0-9][0-9]*|-xarch=*|-xtarget=*|+DA*|+DD*|-q*|-m*| \
       -t[45]*|-txscale*|-p|-pg|--coverage|-fprofile-*|-F*|@*|-tp=*|--sysroot=*|--target=*| \
       -O*|-g*|-flto*|-fwhopr*|-fuse-linker-plugin|-fstack-protector*|-no-canonical-prefixes| \
