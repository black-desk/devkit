# Preserve explicit Clang driver policy in shared-library links.
# TODO: submit this flag support to GNU libtool upstream.
--- a/ltmain.sh
+++ b/ltmain.sh
@@ -7368,6 +7368,11 @@
       # -stdlib=*            select c++ std lib with clang
       # -fsanitize=*         Clang/GCC memory and address sanitizer
       # -fuse-ld=*           Linker select flags for GCC
+      # TODO: upstream Clang config/runtime/linker flag support to libtool.
+      # Preserve the compilation policy when composing shared-library links.
+      --config=*|--no-default-config|--ld-path=*|--gcc-install-dir=*|\
+      --gcc-toolchain=*|--rtlib=*|--unwindlib=*|\
+      --start-no-unused-arguments|--end-no-unused-arguments|\
       -64|-mips[0-9]|-r[0-9][0-9]*|-xarch=*|-xtarget=*|+DA*|+DD*|-q*|-m*| \
       -t[45]*|-txscale*|-p|-pg|--coverage|-fprofile-*|-F*|@*|-tp=*|--sysroot=*| \
       -O*|-g*|-flto*|-fwhopr*|-fuse-linker-plugin|-fstack-protector*|-stdlib=*| \
