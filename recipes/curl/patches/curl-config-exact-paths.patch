--- a/curl-config.in
+++ b/curl-config.in
@@ -25,12 +25,15 @@

 # shellcheck disable=SC2006

-prefix='@prefix@'
+script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
+prefix="$(CDPATH='' cd -- "${script_dir}/../../.." && pwd)"
 # Used in 'libdir'
 # shellcheck disable=SC2034
-exec_prefix="@exec_prefix@"
+exec_prefix="${prefix}"
 # shellcheck disable=SC2034
-includedir="@includedir@"
+includedir="${prefix}/lib/devkit/include/curl-@CURLVERSION@"
+libdir="${prefix}/lib/devkit/lib"
+static_deps="${libdir}/libssl.so ${libdir}/libcrypto.so ${libdir}/libz.so ${libdir}/libnghttp2.so ${libdir}/libssh2.so ${libdir}/libgssapi_krb5.so ${libdir}/libkrb5.so ${libdir}/libk5crypto.so ${libdir}/libcom_err.so ${libdir}/libpsl.so ${libdir}/libzstd.so -ldl -pthread"

 usage()
 {
@@ -70,11 +73,11 @@
     ;;

   --ca)
-    echo '@CURL_CA_BUNDLE@'
+    echo "${prefix}/etc/ssl/certs/ca-certificates.crt"
     ;;

   --cc)
-    echo '@CC@'
+    echo "${prefix}/bin/clang"
     ;;

   --prefix)
@@ -141,23 +144,19 @@
     ;;

   --cflags)
-    if test "@includedir@" = '/usr/include'; then
-      echo '@LIBCURL_PC_CFLAGS@'
+    cflags='@LIBCURL_PC_CFLAGS@'
+    if test -n "$cflags"; then
+      echo "$cflags -I${includedir}"
     else
-      echo "@LIBCURL_PC_CFLAGS@ -I@includedir@"
+      echo "-I${includedir}"
     fi
     ;;

   --libs)
-    if test "@libdir@" != '/usr/lib' && test "@libdir@" != '/usr/lib64'; then
-      curllibdir="-L@libdir@ "
+    if test '@ENABLE_SHARED@' = 'no'; then
+      echo "${libdir}/libcurl.a ${static_deps}"
     else
-      curllibdir=''
-    fi
-    if test '@ENABLE_SHARED@' = 'no'; then
-      echo "${curllibdir}-lcurl @LIBCURL_PC_LIBS_PRIVATE@"
-    else
-      echo "${curllibdir}-lcurl"
+      echo "${libdir}/libcurl.so"
     fi
     ;;

@@ -167,7 +166,7 @@

   --static-libs)
     if test '@ENABLE_STATIC@' != 'no'; then
-      echo "@libdir@/libcurl.@libext@ @LIBCURL_PC_LDFLAGS_PRIVATE@ @LIBCURL_PC_LIBS_PRIVATE@"
+      echo "${libdir}/libcurl.a ${static_deps}"
     else
       echo 'curl was built with static libraries disabled' >&2
       exit 1
