#!/usr/bin/env bash
set -euo pipefail

TOOL_ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Keep tool dependency management under uv without downloading a separate
# managed Python.  The Pixi environment provides both uv and the interpreter.
export UV_PYTHON_DOWNLOADS=never
export UV_NO_CONFIG=1

cd "$TOOL_ROOT"
exec uv run --project "$TOOL_ROOT" python -m dependency_graph "$@"
